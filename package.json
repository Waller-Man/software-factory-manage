{
  "name": "@software-factory/manage", "version": "0.1.0", "private": true, "type": "module",
  "description": "Software factory drafts and authenticated human-approved CUD APIs",
  "main": "./lib/index.js", "types": "./lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./types": { "types": "./lib/types.d.ts", "default": "./lib/types.js" },
    "./client": "./lib/client.js",
    "./preset": "./lib/preset.js",
    "./preset/locale/*.json": "./locale/*.json", "./preset/icon": "./icon.svg",
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" },
    "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg", "./package.json": "./package.json"
  },
  "files": ["lib", "lib/typert.host.js", "lib/typert.host.d.ts", "lib/typert.remote-client.js", "lib/typert.remote-client.d.ts", "cordis.patch.yml", "README.md", "THIRD_PARTY_NOTICES.md", "docs/api.md", "docs/screenshots/*.png", ".env.example", "icon.svg", "locale/*.json", "scripts/check-connection.mjs"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-api-gateway", "@deepseek-ai/dsh-client-connection"] } },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1", "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.2", "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.2", "@software-factory/gateway": "^0.1.1",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-alpha.2", "@deepseek-ai/dsh-fs": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2", "@deepseek-ai/dsh-tools": "0.2.1-alpha.2", "@deepseek-ai/dsh-session": "0.2.1-alpha.2", "@deepseek-ai/dsh-llm": "0.2.1-alpha.2", "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-alpha.2", "@deepseek-ai/dsh-agent-preset": "0.2.1-alpha.2", "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.2", "@deepseek-ai/dsh-working-directory": "0.2.1-alpha.2"
  },
  "scripts": { "build": "node scripts/build.mjs", "typecheck": "node scripts/check.mjs", "test": "node --experimental-transform-types --test tests/*.test.ts", "pack:bundle": "node scripts/pack.mjs" },
  "engines": { "node": ">=24" }
}
